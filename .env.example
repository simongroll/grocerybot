AMAZON_BACKEND=mock              # mock | playwright
AMAZON_BASE_URL=https://www.amazon.co.uk
HEADLESS=1
LOCALE=en-GB                     # browser locale, e.g. en-US for amazon.com

# Optional: LLM matching (falls back to fuzzy-only if unset)
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5     # claude-haiku-5-5 is ~40x cheaper and likely plenty for this

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886     # sandbox number; your own sender later
PUBLIC_BASE_URL=https://your-name.ngrok-free.app   # what Twilio calls; used to check signatures
ALLOWED_WHATSAPP_NUMBERS=+447700900000,+447700900001   # E.164, comma-separated
